# ---------------------------------------------------------------------------
# FuturesRL-X environment configuration (copy to .env; never commit .env)
# ---------------------------------------------------------------------------

# development | paper | live | backtest
FUTURESRLX_ENVIRONMENT=backtest
FUTURESRLX_LOG_LEVEL=INFO

# Data layer
FUTURESRLX_DATABENTO_API_KEY=
FUTURESRLX_DATABENTO_DATASET=GLBX.MDP3
FUTURESRLX_DATA_DIR=./data
FUTURESRLX_PARQUET_DIR=./data/parquet
FUTURESRLX_DUCKDB_PATH=./data/futuresrl_x.duckdb

# IBKR (paper: 7497 TWS / 4002 Gateway, live: 7496 TWS / 4001 Gateway)
FUTURESRLX_IBKR_HOST=127.0.0.1
FUTURESRLX_IBKR_PORT=7497
FUTURESRLX_IBKR_CLIENT_ID=42
FUTURESRLX_IBKR_PAPER=true
FUTURESRLX_IBKR_ACCOUNT=

# Risk engine
FUTURESRLX_RISK__MAX_MARGIN_UTILIZATION=0.60
FUTURESRLX_RISK__TARGET_ANNUAL_VOLATILITY=0.12
FUTURESRLX_RISK__LLM_CONFIDENCE_THRESHOLD=0.70
FUTURESRLX_RISK__LLM_CRITICAL_SCORE=4.5
FUTURESRLX_RISK__DAILY_MAX_LOSS_PCT=0.03

# API
FUTURESRLX_API_HOST=0.0.0.0
FUTURESRLX_API_PORT=8000

# Phase 7 production hardening
FUTURESRLX_ACCOUNT_CURRENCY=USD
FUTURESRLX_FX_RATES={}
FUTURESRLX_RISK_STATE_STORE_URI=
FUTURESRLX_HYDRATION_LOOKBACK_DAYS=400
FUTURESRLX_HYDRATION_BACKFILL_ENABLED=true
FUTURESRLX_RISK__RECONCILE_GRACE_SECONDS=30
FUTURESRLX_RISK__LLM_CACHE_TTL_SECONDS=60
