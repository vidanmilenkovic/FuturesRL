# ---------------------------------------------------------------------------
# FuturesRL environment configuration (copy to .env; never commit .env)
# ---------------------------------------------------------------------------

# development | paper | live | backtest
FUTURESRL_ENVIRONMENT=backtest
FUTURESRL_LOG_LEVEL=INFO

# Data layer
FUTURESRL_DATABENTO_API_KEY=
FUTURESRL_DATABENTO_DATASET=GLBX.MDP3
FUTURESRL_DATA_DIR=./data
FUTURESRL_PARQUET_DIR=./data/parquet
FUTURESRL_DUCKDB_PATH=./data/futuresrl_x.duckdb

# IBKR (paper: 7497 TWS / 4002 Gateway, live: 7496 TWS / 4001 Gateway)
FUTURESRL_IBKR_HOST=127.0.0.1
FUTURESRL_IBKR_PORT=7497
FUTURESRL_IBKR_CLIENT_ID=42
FUTURESRL_IBKR_PAPER=true
FUTURESRL_IBKR_ACCOUNT=

# Risk engine
FUTURESRL_RISK__MAX_MARGIN_UTILIZATION=0.60
FUTURESRL_RISK__TARGET_ANNUAL_VOLATILITY=0.12
FUTURESRL_RISK__LLM_CONFIDENCE_THRESHOLD=0.70
FUTURESRL_RISK__LLM_CRITICAL_SCORE=4.5
FUTURESRL_RISK__DAILY_MAX_LOSS_PCT=0.03

# API
FUTURESRL_API_ENABLE_IBKR=0
FUTURESRL_API_HOST=0.0.0.0
FUTURESRL_API_PORT=8000

# Production hardening (account, reconciliation, risk state)
FUTURESRL_ACCOUNT_CURRENCY=USD
FUTURESRL_FX_RATES={}
FUTURESRL_RISK_STATE_STORE_URI=
FUTURESRL_HYDRATION_LOOKBACK_DAYS=400
FUTURESRL_HYDRATION_BACKFILL_ENABLED=true
FUTURESRL_HYDRATION_SOURCE=auto
FUTURESRL_RISK__RECONCILE_GRACE_SECONDS=30
FUTURESRL_RISK__LLM_CACHE_TTL_SECONDS=60

# LLM risk provider, live news and runner bridge
# offline = deterministic fixtures; providers: openai | anthropic | deepseek | gemini | vllm
FUTURESRL_LLM_PROVIDER=offline
FUTURESRL_LLM_MODEL=gpt-4o-mini
FUTURESRL_LLM_BASE_URL=
FUTURESRL_LLM_API_KEY=
FUTURESRL_NEWS_RSS_FEEDS=[]
FUTURESRL_NEWS_MAX_ITEMS=20
FUTURESRL_NEWS_POLL_INTERVAL_SECONDS=300
FUTURESRL_RUNNER_BRIDGE_ENABLED=true
