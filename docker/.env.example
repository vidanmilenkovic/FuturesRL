# ---------------------------------------------------------------------------
# FuturesRL environment template for docker compose.
#
#   cp docker/.env.example docker/.env
#
# Compose interpolates ${VAR} from docker/.env. Credentials belong only in that
# git-ignored file; never commit real secrets.
# ---------------------------------------------------------------------------

# --- Runtime profile -------------------------------------------------------
# development | paper | live | backtest
FUTURESRL_ENVIRONMENT=paper
FUTURESRL_LOG_LEVEL=INFO

# --- Optional IBKR headless IB Gateway (ghcr.io/gnzsnz/ib-gateway) ----------
# Start with: docker compose --profile ibkr up
# Paper trading only. Use IBKR paper credentials; never commit these values.
TWS_USERID=
TWS_PASSWORD=
IB_GATEWAY_TRADING_MODE=paper   # paper | live
IB_GATEWAY_PORT=4003            # published host port (4004 for live)
IB_GATEWAY_INTERNAL_PORT=4003   # 4004 for live
IB_GATEWAY_VNC_PORT=5900
# Comma-separated list of IPs allowed to reach the gateway API (empty = all).
IB_GATEWAY_TRUSTED_IPS=

# --- Backend API -----------------------------------------------------------
API_PORT=8000
# IBKR endpoint as seen from inside the compose network.
FUTURESRL_IBKR_HOST=ib-gateway
FUTURESRL_IBKR_PORT=4003
FUTURESRL_IBKR_CLIENT_ID=42
FUTURESRL_IBKR_PAPER=true
# 0 = offline simulated broker (demo/CI default); 1 = attempt real IBKR session.
FUTURESRL_API_ENABLE_IBKR=0
# Optional Databento key for live/historical ingestion (blank = offline).
DATABENTO_API_KEY=

# --- Local-first storage ---------------------------------------------------
# Parquet cache, DuckDB and backtest artifacts live in named Docker volumes.
# No external database or cache services are required.

# --- Frontend --------------------------------------------------------------
FRONTEND_PORT=3100
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/telemetry
