# ---------------------------------------------------------------------------
# FuturesRL-X environment template for docker compose.
#
#   cp docker/.env.example docker/.env     # then fill in the secrets
#
# Docker Compose loads `docker/.env` automatically for ${VAR} interpolation in
# docker-compose.yml. This file is the ONLY place credentials should live and
# `docker/.env` is git-ignored — never commit real secrets.
# ---------------------------------------------------------------------------

# --- Runtime profile -------------------------------------------------------
# development | paper | live | backtest
FUTURESRLX_ENVIRONMENT=paper
FUTURESRLX_LOG_LEVEL=INFO

# --- TimescaleDB -----------------------------------------------------------
POSTGRES_USER=futuresrlx
POSTGRES_PASSWORD=change-me-futuresrlx
POSTGRES_DB=futuresrlx
# Host port binding for psql/BI tools (compose-internal port is always 5432).
POSTGRES_PORT=5432

# --- Redis -----------------------------------------------------------------
REDIS_PASSWORD=change-me-redis

# --- IBKR headless IB Gateway (ghcr.io/gnzsnz/ib-gateway) -------------------
# Paper trading only. Use your IBKR *paper* credentials; the gateway container
# refuses to start without them. Never commit these values.
TWS_USERID=
TWS_PASSWORD=
# paper = port 4003 (paper gateway) ; live would require port 4004 + real creds
IB_GATEWAY_PORT=4003
IB_GATEWAY_VNC_PORT=5900
# Comma-separated list of IPs allowed to reach the gateway API (empty = all).
IB_GATEWAY_TRUSTED_IPS=

# --- Backend API -----------------------------------------------------------
API_PORT=8000
# IBKR endpoint as seen from inside the compose network.
FUTURESRLX_IBKR_HOST=ib-gateway
FUTURESRLX_IBKR_PORT=4003
FUTURESRLX_IBKR_CLIENT_ID=42
FUTURESRLX_IBKR_PAPER=true
# 0 = offline simulated broker (demo/CI default); 1 = attempt real IBKR session.
FUTURESRLX_API_ENABLE_IBKR=0
# Optional Databento key for live/historical ingestion (leave blank for offline).
DATABENTO_API_KEY=

# --- Frontend --------------------------------------------------------------
FRONTEND_PORT=3100
# Must be the origin a *browser* can reach (baked into the Next.js bundle).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/telemetry
